# 이 파일을 복사해 .env 로 이름을 바꾸고 값을 채운다.
# .env 는 저장소에 올리지 않는다. (.gitignore 에 등록되어 있다)

# 공공데이터포털 (data.go.kr) 일반 인증키(Decoding). 실거래가, 건축물대장에 함께 쓴다.
DATA_GO_KR_KEY=

# 카카오 개발자 사이트 (developers.kakao.com)
# JavaScript 키: 화면의 지도에 쓴다. 사이트 주소 등록으로 보호한다.
KAKAO_JS_KEY=
# REST API 키: 서버에서 주소를 좌표로 바꿀 때 쓴다. 화면 코드에 넣지 않는다.
KAKAO_REST_API_KEY=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=money_to_home
DB_USER=
DB_PASSWORD=
# 클라우드 DB(Aiven 등)에 붙을 때만 true. 로컬 MariaDB는 비워 둔다
DB_SSL=
# (선택) DB 회사가 주는 CA 인증서 파일 경로. 비우면 암호화만 하고 인증서는 확인하지 않는다
DB_SSL_CA=

# 로그인 세션 서명 키 (2차). 길고 무작위인 문자열
SESSION_SECRET_KEY=
